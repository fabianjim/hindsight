# openssl rand -hex 32
HINDSIGHT_SERVICE_TOKEN=
HINDSIGHT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54322/postgres
HINDSIGHT_OPENAI_API_KEY=
# leave blank to disable tracing
HINDSIGHT_LANGFUSE_PUBLIC_KEY=
HINDSIGHT_LANGFUSE_SECRET_KEY=
# usd millionths; -1 means uncapped
HINDSIGHT_LIFETIME_BUDGET_MICROS=-1
HINDSIGHT_DAILY_BUDGET_MICROS=100000
HINDSIGHT_DAILY_GENERATIONS=100
