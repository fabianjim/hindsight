          "aids"
        ],
        "title": "SavedReflectionAidList",
        "type": "object"
      },
      "Since": {
        "properties": {
          "priceNow": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pricenow"
          },
          "sharesNow": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sharesnow"
          },
          "trades": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Trade"
            },
            "maxItems": 20,
            "title": "Trades",
            "type": "array"
          }
        },
        "title": "Since",
        "type": "object"
      },
      "Trade": {
        "properties": {
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "price": {
            "exclusiveMinimum": 0.0,
            "title": "Price",
            "type": "number"
          },
          "shares": {
            "exclusiveMinimum": 0.0,
            "title": "Shares",
            "type": "number"
          },
          "type": {
            "enum": [
              "BUY",
              "SELL"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "day",
          "type",
          "shares",
          "price"
        ],
        "title": "Trade",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
