{
  "components": {
    "schemas": {
      "Citation": {
        "properties": {
          "entryId": {
            "title": "Entryid",
            "type": "integer"
          },
          "quote": {
            "title": "Quote",
            "type": "string"
          }
        },
        "required": [
          "entryId",
          "quote"
        ],
        "title": "Citation",
        "type": "object"
      },
      "Claim": {
        "properties": {
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "minItems": 1,
            "title": "Citations",
            "type": "array"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "summary",
          "citations"
        ],
        "title": "Claim",
        "type": "object"
      },
      "Emotion": {
        "enum": [
          "confident",
          "excited",
          "curious",
          "calm",
          "uncertain",
          "anxious",
          "fomo",
          "regret",
          "relieved",
          "frustrated"
        ],
        "title": "Emotion",
        "type": "string"
      },
      "EntryInsight": {
        "properties": {
          "conviction": {
            "anyOf": [
              {
                "enum": [
                  1,
                  2,
                  3,
                  4,
                  5
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conviction"
          },
          "emotions": {
            "items": {
              "$ref": "#/components/schemas/Emotion"
            },
            "title": "Emotions",
            "type": "array"
          },
          "exitCondition": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Claim"
              },
              {
                "type": "null"
              }
            ]
          },
          "horizon": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Horizon"
              },
              {
                "type": "null"
              }
            ]
          },
          "ideaSource": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IdeaSource"
              },
              {
                "type": "null"
              }
            ]
          },
          "themes": {
            "items": {
              "type": "string"
            },
            "title": "Themes",
            "type": "array"
          },
          "thesis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Claim"
              },
              {
                "type": "null"
              }
            ]
          },
          "tickers": {
            "items": {
              "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$",
              "type": "string"
            },
            "title": "Tickers",
            "type": "array"
          }
        },
        "required": [
          "thesis",
          "exitCondition",
          "horizon",
          "conviction",
          "emotions",
          "ideaSource",
          "tickers",
          "themes"
        ],
        "title": "EntryInsight",
        "type": "object"
      },
      "EntryInsightItem": {
        "properties": {
          "entryId": {
            "title": "Entryid",
            "type": "integer"
          },
          "insight": {
            "$ref": "#/components/schemas/EntryInsight"
          }
        },
        "required": [
          "entryId",
          "insight"
        ],
        "title": "EntryInsightItem",
        "type": "object"
      },
      "EntryInsightList": {
        "properties": {
          "insights": {
            "items": {
              "$ref": "#/components/schemas/EntryInsightItem"
            },
            "title": "Insights",
            "type": "array"
          }
        },
        "required": [
          "insights"
        ],
        "title": "EntryInsightList",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Horizon": {
        "enum": [
          "days",
          "weeks",
          "months",
          "years"
        ],
        "title": "Horizon",
        "type": "string"
      },
      "IdeaSource": {
        "enum": [
          "own_research",
          "news",
          "social_media",
          "friend_or_family",
          "professional"
        ],
        "title": "IdeaSource",
        "type": "string"
      },
      "Problem": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReflectionAid": {
        "properties": {
          "questions": {
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "title": "Questions",
            "type": "array"
          },
          "recap": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "maxItems": 3,
            "title": "Recap",
            "type": "array"
          }
        },
        "required": [
          "recap",
          "questions"
        ],
        "title": "ReflectionAid",
        "type": "object"
      },
      "ReflectionAidRequest": {
        "properties": {
          "laterEntryIds": {
            "default": [],
            "items": {
              "type": "integer"
            },
            "maxItems": 50,
            "title": "Laterentryids",
            "type": "array"
          },
          "since": {
            "$ref": "#/components/schemas/Since",
            "default": {
              "trades": []
            }
          }
        },
        "title": "ReflectionAidRequest",
        "type": "object"
      },
      "ReflectionAidResult": {
        "properties": {
          "aid": {
            "$ref": "#/components/schemas/ReflectionAid"
          },
          "generatedOn": {
            "format": "date",
            "title": "Generatedon",
            "type": "string"
          },
          "remainingToday": {
            "title": "Remainingtoday",
            "type": "integer"
          }
        },
        "required": [
          "aid",
          "generatedOn",
          "remainingToday"
        ],
        "title": "ReflectionAidResult",
        "type": "object"
      },
      "Since": {
        "properties": {
          "priceNow": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pricenow"
          },
          "sharesNow": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sharesnow"
          },
          "trades": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Trade"
            },
            "maxItems": 20,
            "title": "Trades",
            "type": "array"
          }
        },
        "title": "Since",
        "type": "object"
      },
      "Trade": {
        "properties": {
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "price": {
            "exclusiveMinimum": 0.0,
            "title": "Price",
            "type": "number"
          },
          "shares": {
            "exclusiveMinimum": 0.0,
            "title": "Shares",
            "type": "number"
          },
          "type": {
            "enum": [
              "BUY",
              "SELL"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "day",
          "type",
          "shares",
          "price"
        ],
        "title": "Trade",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "hindsight",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/users/{userId}/entries/{entryId}/reflection-aid": {
      "post": {
        "operationId": "create_reflection_aid",
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": {
              "title": "Userid",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "entryId",
            "required": true,
            "schema": {
              "title": "Entryid",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReflectionAidRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReflectionAidResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No entry with text for this user"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The user's aids for today are used up"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "AI is off, out of budget or unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Reflection Aid"
      }
    },
    "/v1/users/{userId}/insights": {
      "get": {
        "operationId": "list_insights",
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": {
              "title": "Userid",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "entryIds",
            "required": true,
            "schema": {
              "items": {
                "type": "integer"
              },
              "maxItems": 200,
              "minItems": 1,
              "title": "Entryids",
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryInsightList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Insights"
      }
    }
  }
}
